# ─── Ethereum ────────────────────────────────────────────────
# JSON-RPC endpoint (Infura, Alchemy, local Anvil, etc.)
RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY_HERE

# Private key of the oracle wallet (DO NOT commit this file!)
ORACLE_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed PokeBetArena contract address
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# ─── Pokémon Showdown (optional auth) ────────────────────────
# If blank the oracle runs as a guest (can still read battle rooms)
PS_USERNAME=
PS_PASSWORD=

# ─── Logging ─────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
